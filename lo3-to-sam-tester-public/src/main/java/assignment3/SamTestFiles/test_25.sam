start:
JUMP Main_main
square_new:
ADDSP 1
PUSHOFF 2
STOREOFF 2
PUSHIMMSTR "xyz"
STOREOFF 3
PUSHOFF 1
PUSHIMM 0
ADD
PUSHOFF 1
STOREIND
PUSHOFF 1
PUSHIMM 1
ADD
PUSHOFF 2
STOREIND
PUSHOFF 1
PUSHIMM 2
ADD
PUSHOFF 3
STOREIND
end_square_new_111:
POPFBR
JUMPIND
square_getArea:
ADDSP 0
PUSHOFF -1
PUSHIMM 1
ADD
PUSHIND
PUSHOFF -1
PUSHIMM 1
ADD
PUSHIND
TIMES
JUMP end_square_getArea_112
end_square_getArea_112:
STOREOFF -2
ADDSP -0
JUMPIND
square_getName:
ADDSP 0
PUSHOFF -1
PUSHIMM 2
ADD
PUSHIND
JUMP end_square_getName_113
end_square_getName_113:
STOREOFF -2
ADDSP -0
JUMPIND
Main_get:
ADDSP 0
PUSHOFF -1
PUSHIMM 1
ADD
PUSHIND
JUMP end_Main_get_115
end_Main_get_115:
STOREOFF -2
ADDSP -0
JUMPIND
Main_main:
ADDSP 2
PUSHIMM 0
LINK
PUSHIMM 3
MALLOC
PUSHIMM 4
PUSHIMM 0
PUSHSP
PUSHIMM 4
SUB
PUSHFBR
JSR square_new
POPFBR
