start:
JUMP Main_main
car_new:
ADDSP 1
PUSHOFF 1
PUSHIMM 0
ADD
PUSHIMM 0
STOREIND
POPFBR
JUMPIND
car_carPrice:
ADDSP 0
PUSHIMM 10
JUMP end_car_carPrice_1
end_car_carPrice_1:
STOREOFF -2
ADDSP -0
JUMPIND
Main_main:
ADDSP 2
PUSHIMM 0
LINK
PUSHIMM 1
MALLOC
PUSHSP
PUSHIMM 2
SUB
PUSHFBR
JSR car_new
POPFBR
ADDSP -1
STOREOFF -1
POPFBR
STOREOFF 1
PUSHIMM 0
PUSHOFF 1
LINK
JSR car_carPrice
POPFBR
ADDSP -1
JUMP end_Main_main_3
end_Main_main_3:
STOREOFF 0
ADDSP -1
STOP
